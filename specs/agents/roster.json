        "plan"
      ],
      "features": [
        "*"
      ],
      "color": "#8b5cf6",
      "icon": "compass",
      "scope": [
        "specs/features/*/plan.md"
      ],
      "guardrails": [
        "pii-scan",
        "spec-frontmatter",
        "acceptance-criteria-present",
        "token-budget",
        "memory-provenance"
      ],
